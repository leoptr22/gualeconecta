PORT=3001
# sqlite | sheets. SQLite persiste en el disco del servidor.
STORAGE=sqlite
# Opcional: ruta a la base de datos. Por defecto: data/publicaciones.sqlite.
DATABASE_PATH=
# Archivos adjuntos. Por defecto data/uploads (requiere disco persistente).
MEDIA_PATH=
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
# Clave privada para aprobar publicaciones mediante API. Nunca usar VITE_ para secretos.
ADMIN_TOKEN=
# Cuenta administrativa local; la contraseña se guarda solo como hash scrypt.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# OAuth: client ID de tipo aplicación web. No necesita client secret para GIS.
GOOGLE_CLIENT_ID=
APP_ORIGIN=http://127.0.0.1:5173
# Opcional. Por defecto data/accounts.sqlite, incluso cuando anuncios usan Sheets.
AUTH_DATABASE_PATH=
# Estadísticas de visitas. Por defecto data/visitas.sqlite, incluso con Sheets.
ANALYTICS_DATABASE_PATH=
