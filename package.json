    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "cookie": "^2.0.1",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "express-rate-limit": "^7.5.0",
    "ffprobe-static": "^3.1.0",
    "google-auth-library": "^11.1.0",
    "multer": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
