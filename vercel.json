{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "gualeconecta.vercel.app" }],
      "destination": "https://gualeconecta-leoptr22s-projects.vercel.app/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "excludeFiles": "node_modules/ffprobe-static/bin/{darwin,win32,linux/ia32}/**"
    }
  },
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
